rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Valid Document ID
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny for all documents and collections
    // Direct browser access to sensitive application collections is strictly forbidden.
    // All data access must pass through the trusted Express backend API.
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicit deny for all sensitive application collections
    match /users/{userId} {
      allow read, write: if false;
    }

    match /classes/{classId} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    match /activityProgress/{progressId} {
      allow read, write: if false;
    }

    match /assessmentAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /missionSubmissions/{submissionId} {
      allow read, write: if false;
    }

    match /missions/{missionId} {
      allow read, write: if false;
    }

    match /xpTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /badges/{badgeId} {
      allow read, write: if false;
    }

    match /userBadges/{badgeId} {
      allow read, write: if false;
    }

    match /dailyTipClaims/{claimId} {
      allow read, write: if false;
    }

    match /weeklyChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /grandeMissaoProgress/{userId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
